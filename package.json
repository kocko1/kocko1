{
  "name": "capri-edgerunner-widget",
  "version": "1.0.0",
  "description": "Cyberpunk: Edgerunners Season 2 - Capri Floating Desktop AI Companion Widget",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "cyberpunk",
    "edgerunners",
    "capri",
    "desktop-widget",
    "electron",
    "ai-companion",
    "overlay"
  ],
  "author": "Night City Netrunners",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.nightcity.capri.widget",
    "productName": "Capri // Edgerunner HUD",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/capri-sprite.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/capri-sprite.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/capri-sprite.png"
    }
  }
}
